# Copy to backend/.env. Keep real credentials out of source control.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Use supabase for PostgreSQL application records, or mongo for local MongoDB.
DATABASE_BACKEND=mongo
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=skipti
SESSION_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional instead of GEMINI_API_KEY, install requirements-emergent.txt:
# EMERGENT_LLM_KEY=
